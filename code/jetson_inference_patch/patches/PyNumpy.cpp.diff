+// Initialize NumPy (avoid "control reaches end of non-void function" on Py3)
+// PyMODINIT_FUNC maps to a non-void return on Python 3.
+PyMODINIT_FUNC PyNumpy_ImportNumpy()
+{
+    import_array();        // returns NULL on failure in Py3
+    // import_ufunc();     // only needed if using ufuncs
+    // Return a sentinel value to satisfy compilers;
+    // callers ignore the return value.
+    return NULL;
+}
 
